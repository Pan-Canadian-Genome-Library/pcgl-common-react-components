{
  "name": "@repo/ui",
  "version": "0.0.0-bulbasaur-20261109204722",
  "license": "LGPL-3.0-only",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./footer": {
      "types": "./dist/footer/index.d.ts",
      "import": "./dist/footer/index.mjs",
      "default": "./dist/footer/index.js"
    },
    "./*/styles.css": "./dist/*/styles.css",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.mjs",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && tsc --emitDeclarationOnly && node scripts/build-css.mjs",
    "dev": "tsc --emitDeclarationOnly && node scripts/build-css.mjs && tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo node_modules dist",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "jest-axe": "^11.0.0",
    "postcss": "8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1"
  }
}
