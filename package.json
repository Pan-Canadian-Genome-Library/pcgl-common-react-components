{
  "private": true,
  "license": "LGPL-3.0-only",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"{apps,packages,turbo}/**/*.{ts,tsx,js,mjs,cjs,json,css,md}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{apps,packages,turbo}/**/*.{ts,tsx,js,mjs,cjs,json,css,md}\" \"*.{json,md}\"",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "storybook": "pnpm --filter docs storybook",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest --watch"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@repo/vitest-config": "workspace:*",
    "@turbo/gen": "^2.11.9",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.9.1",
  "name": "research-portal-components"
}
